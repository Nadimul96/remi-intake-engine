# Local development (`pnpm dev`). `docker compose up` needs no .env: every value has a
# working default in docker-compose.yml, and anything set here overrides it.
#
# `pnpm dev:infra` starts Postgres, Temporal and storage in Docker for this path;
# docker-compose.dev.yml publishes their ports on 127.0.0.1 (5432, 7233, 9000). The plain
# `docker compose up` stack publishes only 3000, 8233 and 9000, so it never needs these.

# --- Postgres -----------------------------------------------------------------
DATABASE_URL=postgresql://remi:remi@127.0.0.1:5432/remi

# --- Temporal -----------------------------------------------------------------
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
INTAKE_TASK_QUEUE=remi-intake

# --- Object storage (any S3-compatible server; compose runs RustFS) --------------
S3_ENDPOINT=http://127.0.0.1:9000
# Host the browser uses for presigned uploads, if different from S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
S3_BUCKET=remi-dev
S3_ACCESS_KEY=remi-local
S3_SECRET_KEY=remi-local-secret
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# --- Services -------------------------------------------------------------------
API_PORT=4001
EXTRACTOR_URL=http://127.0.0.1:4003
# Comma-separated browser origins allowed to call the API and upload to storage.
CONSOLE_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Single-tenant stub identity until real auth exists.
DEFAULT_TENANT_ID=fund-zero
DEFAULT_ACTOR_ID=operator-demo

# --- Compose host ports (optional overrides; all bind to 127.0.0.1) ---------------
# docker compose up:   CONSOLE_PORT=3000  STORAGE_PORT=9000  TEMPORAL_UI_PORT=8233
# pnpm dev:infra adds: POSTGRES_PORT=5432  TEMPORAL_PORT=7233  STORAGE_CONSOLE_PORT=9001
#                      (and API_PORT / EXTRACTOR_PORT if you start those services in Docker)

# --- Optional: AI-assisted extraction (off by default; no key needed otherwise) --
# off | gemini | openai   ("openai" means any OpenAI-compatible endpoint, including Ollama)
MODEL_EXTRACTION=off
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=
# e.g. http://127.0.0.1:11434/v1 for a local Ollama, or https://api.openai.com/v1
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
